<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:local="using:Explorer"
             x:Class="Explorer.App"
             RequestedThemeVariant="Default">

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>

	<Application.Resources>
		<ResourceDictionary>
			<FontFamily x:Key="DmSansFont">avares://Explorer/Assets/Fonts/#DM Sans</FontFamily>
			<StaticResource x:Key="DefaultFontFamily" ResourceKey="DmSansFont" />

			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Explorer/Theme/Colors.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<semi:SemiTheme Locale="fr-FR" />
		<semi:UrsaSemiTheme Locale="fr-FR" />

		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/DataGrid.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/Checkbox.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/Button.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/TextBox.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/Expander.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/ContextMenu.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/ToolTip.axaml" />
		<StyleInclude Source="avares://Explorer/Theme/Controls/Divider.axaml" />
	</Application.Styles>
</Application>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="Button.ghost">
		<Setter Property="Padding" Value="6" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="40" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{StaticResource ColorWhiteBrush}" />
	</Style>

	<Style Selector="Button.ghost Svg">
		<Setter Property="IsHitTestVisible" Value="False" />
	</Style>

	<Style
		Selector="Button.ghost:pointerover /template/ ContentPresenter, Button.ghost:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
	</Style>
</Styles>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d"
             x:Name="NavBarControl"
             x:Class="Explorer.Controls.NavBar"
             x:DataType="vm:NavBarViewModel">

    <UserControl.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button:disabled Path">
            <Setter Property="Stroke" Value="#4A4A4A" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource BackgroundDefault}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0"
            ClipToBounds="True">

        <Grid Margin="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="40"
                        VerticalAlignment="Center">

                <Button Command="{Binding Navigation.GoBackCommand}"
                        IsEnabled="{Binding Navigation.CanGoBack}"
                        VerticalAlignment="Center"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Path Data="M0.5 3.5H13.5M3.75 6.5L0.5 3.5L3.75 0.5"
                          Width="14"
                          Height="7"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding Navigation.GoForwardCommand}"
                        IsEnabled="{Binding Navigation.CanGoForward}"
                        VerticalAlignment="Center"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Path Data="M13.5 3.5L0.5 3.5M10.25 0.5L13.5 3.5L10.25 6.5"
                          Width="14"
                          Height="7"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding Navigation.GoUpCommand}"
                        IsEnabled="{Binding Navigation.CanGoUp}"
                        VerticalAlignment="Center"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Path Data="M3.5 0.5L3.5 13.5M0.5 3.75L3.5 0.5L6.5 3.75"
                          Width="7"
                          Height="14"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                </Button>

                <Button Command="{Binding Navigation.ReloadCommand}"
                        VerticalAlignment="Center"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Svg Path="/Assets/Icons/Reload.svg"
                         Width="15"
                         Height="15"
                         VerticalAlignment="Center"
                         Css="path { stroke: white }" />
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding Navigation.CurrentPath}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Margin="40,0" />

            <StackPanel Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        Spacing="15"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Border Width="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{StaticResource BorderDefault}" />

                <TextBlock Text="NOUVEAU" VerticalAlignment="Center" FontSize="13" />

                <Border Width="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{StaticResource BorderDefault}" />

                <TextBlock Text="COPIER" VerticalAlignment="Center" FontSize="13" />
                <TextBlock Text="COLLER" VerticalAlignment="Center" FontSize="13" />
                <TextBlock Text="COUPER" VerticalAlignment="Center" FontSize="13" />
                <TextBlock Text="{Binding DataGrid.SelectedItemCount, StringFormat='SUPPRIMER ({0})'}"
                           VerticalAlignment="Center" FontSize="13" />

                <Border Width="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{StaticResource BorderDefault}" />

                <TextBlock Text="OCR" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
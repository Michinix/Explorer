<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:primitives="using:Explorer.Controls.Primitives"
             xmlns:converters="using:Avalonia.Data.Converters"
             mc:Ignorable="d"
             x:Name="NavBarControl"
             x:Class="Explorer.Controls.NavBar"
             x:DataType="vm:NavBarViewModel">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Svg">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Css" Value="path { fill: white }" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Button:disabled Svg">
            <Setter Property="Css" Value="path { opacity: 0.35 }" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical">

        <Border Background="{StaticResource BackgroundDefault}"
                BorderBrush="{StaticResource BorderDefault}"
                Height="40"
                BorderThickness="0,0,0,1"
                CornerRadius="10,10,0,0"
                ClipToBounds="True">

            <Grid Margin="15,0,10,0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="20">

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="31"
                            VerticalAlignment="Center">

                    <Button Command="{Binding Navigation.GoBackCommand}" IsEnabled="{Binding Navigation.CanGoBack}">
                        <Svg Path="/Assets/Icons/Left.svg" />
                    </Button>

                    <Button Command="{Binding Navigation.GoForwardCommand}"
                            IsEnabled="{Binding Navigation.CanGoForward}">
                        <Svg Path="/Assets/Icons/Right.svg" />
                    </Button>

                    <Button Command="{Binding Navigation.GoUpCommand}" IsEnabled="{Binding Navigation.CanGoUp}">
                        <Svg Path="/Assets/Icons/Top.svg" />
                    </Button>

                    <Button Command="{Binding Navigation.ReloadCommand}">
                        <Svg Path="/Assets/Icons/Reload.svg" />
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <primitives:PathEditor Grid.Column="0"
                                           Text="{Binding Navigation.EditablePath, Mode=TwoWay}"
                                           SubmitCommand="{Binding Navigation.SubmitEditedPathCommand}"
                                           VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="3" Padding="10,6" Width="205"
                            VerticalAlignment="Center">
                        <TextBlock Text="Rechercher..." FontSize="13" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Background="{StaticResource BackgroundDefault}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1"
                Height="40">

            <StackPanel Orientation="Horizontal"
                        Spacing="11"
                        Margin="13,0,0,0"
                        VerticalAlignment="Center">

                <primitives:NewItemButton CreateFolderCommand="{Binding DataGrid.CreateFolderCommand}"
                                          CreateFileCommand="{Binding DataGrid.CreateFileCommand}" />

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />

                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Button IsEnabled="{Binding !!DataGrid.SelectedItemCount}">
                        <Svg Path="/Assets/Icons/Cut.svg" />
                    </Button>
                    <Button IsEnabled="{Binding !!DataGrid.SelectedItemCount}">
                        <Svg Path="/Assets/Icons/Copy.svg" />
                    </Button>
                    <Button>
                        <Svg Path="/Assets/Icons/Paste.svg" />
                    </Button>
                    <Button Command="{Binding DataGrid.RenameCommand}"
                            IsEnabled="{Binding DataGrid.SelectedEntry, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                        <Svg Path="/Assets/Icons/Rename.svg" />
                    </Button>
                    <Button Command="{Binding DataGrid.DeleteSelectedCommand}"
                            IsEnabled="{Binding !!DataGrid.SelectedItemCount}">
                        <Svg Path="/Assets/Icons/Trash.svg" />
                    </Button>
                </StackPanel>

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />

                <TextBlock Text="{Binding DataGrid.SelectedItemCount, StringFormat='Éléments sélectionnés : {0}'}"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center" />

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />

                <Button>
                    <TextBlock Text="OCR" FontSize="13" />
                </Button>

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
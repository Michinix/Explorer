<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:controls="using:Explorer.Controls.Primitives"
             xmlns:converters="using:Avalonia.Data.Converters"
             mc:Ignorable="d"
             x:Name="NavBarControl"
             x:Class="Explorer.Controls.NavBar"
             x:DataType="vm:NavBarViewModel">

    <UserControl.Styles>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="#09090B" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#27272A" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#27272A" />
        </Style>

        <Style Selector="TextBox.pathEditor">
            <Setter Property="Cursor" Value="IBeam" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>

        <Style Selector="Button Svg">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0.15" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical">

        <Border Background="{StaticResource BackgroundDefault}"
                BorderBrush="{StaticResource BorderDefault}"
                Height="40"
                BorderThickness="0,0,0,1"
                CornerRadius="10,10,0,0"
                ClipToBounds="True">

            <Grid Margin="15,0,10,0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="20">

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="31"
                            VerticalAlignment="Center">

                    <Button Command="{Binding Navigation.GoBackCommand}" IsEnabled="{Binding Navigation.CanGoBack}">
                        <Path Data="M0.5 3.5H13.5M3.75 6.5L0.5 3.5L3.75 0.5" Width="14" Height="7" Stretch="Uniform" />
                    </Button>

                    <Button Command="{Binding Navigation.GoForwardCommand}"
                            IsEnabled="{Binding Navigation.CanGoForward}">
                        <Path Data="M13.5 3.5L0.5 3.5M10.25 0.5L13.5 3.5L10.25 6.5" Width="14" Height="7"
                              Stretch="Uniform" />
                    </Button>

                    <Button Command="{Binding Navigation.GoUpCommand}" IsEnabled="{Binding Navigation.CanGoUp}">
                        <Path Data="M3.5 0.5L3.5 13.5M0.5 3.75L3.5 0.5L6.5 3.75" Width="7" Height="14"
                              Stretch="Uniform" />
                    </Button>

                    <Button Command="{Binding Navigation.ReloadCommand}">
                        <Svg Path="/Assets/Icons/Reload.svg" Css="path { stroke: white }" />
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <controls:PathEditor Grid.Column="0"
                                         Text="{Binding Navigation.EditablePath, Mode=TwoWay}"
                                         SubmitCommand="{Binding Navigation.SubmitEditedPathCommand}"
                                         VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="3" Padding="10,6" Width="205"
                            VerticalAlignment="Center">
                        <TextBlock Text="Rechercher..." FontSize="13" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Background="{StaticResource BackgroundDefault}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1"
                Height="40">

            <StackPanel Orientation="Horizontal"
                        Spacing="11"
                        Margin="13,0,0,0"
                        VerticalAlignment="Center">

                <Button>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Fichier" Command="{Binding DataGrid.CreateFileCommand}">
                                <MenuItem.Icon>
                                    <Svg Path="/Assets/Icons/Document.svg" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Dossier" Command="{Binding DataGrid.CreateFolderCommand}">
                                <MenuItem.Icon>
                                    <Svg Path="/Assets/Icons/Directory.svg" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Svg Path="/Assets/Icons/New.svg" />
                        <TextBlock Text="Nouveau" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />

                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Button IsEnabled="{Binding !!DataGrid.SelectedItemCount}">
                        <Svg Path="/Assets/Icons/Cut.svg" />
                    </Button>
                    <Button IsEnabled="{Binding !!DataGrid.SelectedItemCount}">
                        <Svg Path="/Assets/Icons/Copy.svg" />
                    </Button>
                    <Button>
                        <Svg Path="/Assets/Icons/Paste.svg" />
                    </Button>
                    <Button Command="{Binding DataGrid.RenameCommand}"
                            IsEnabled="{Binding DataGrid.SelectedEntry, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                        <Svg Path="/Assets/Icons/Rename.svg" />
                    </Button>
                    <Button Command="{Binding DataGrid.DeleteSelectedCommand}"
                            IsEnabled="{Binding !!DataGrid.SelectedItemCount}">
                        <Svg Path="/Assets/Icons/Trash.svg" />
                    </Button>
                </StackPanel>

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />

                <TextBlock Text="{Binding DataGrid.SelectedItemCount, StringFormat='Éléments sélectionnés : {0}'}"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center" />

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />

                <Button>
                    <TextBlock Text="OCR" FontSize="13" />
                </Button>

                <Border Width="1" Height="30" Background="{StaticResource BorderDefault}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
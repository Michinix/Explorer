<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d"
             x:Name="NavBarControl"
             x:Class="Explorer.Controls.NavBar"
             x:DataType="vm:NavBarViewModel">

    <UserControl.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button Path">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button:disabled Path">
            <Setter Property="Stroke" Value="#4A4A4A" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource BackgroundDefault}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0"
            ClipToBounds="True">

        <Grid Margin="15,0,5,0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="15">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="45"
                        VerticalAlignment="Center">

                <Button Command="{Binding Navigation.GoBackCommand}"
                        IsEnabled="{Binding Navigation.CanGoBack}">
                    <Path Data="M0.5 3.5H13.5M3.75 6.5L0.5 3.5L3.75 0.5"
                          Width="14"
                          Height="7"
                          Stretch="Uniform" />
                </Button>

                <Button Command="{Binding Navigation.GoForwardCommand}"
                        IsEnabled="{Binding Navigation.CanGoForward}">
                    <Path Data="M13.5 3.5L0.5 3.5M10.25 0.5L13.5 3.5L10.25 6.5"
                          Width="14"
                          Height="7"
                          Stretch="Uniform" />
                </Button>

                <Button Command="{Binding Navigation.GoUpCommand}"
                        IsEnabled="{Binding Navigation.CanGoUp}">
                    <Path Data="M3.5 0.5L3.5 13.5M0.5 3.75L3.5 0.5L6.5 3.75"
                          Width="7"
                          Height="14"
                          Stretch="Uniform" />
                </Button>

                <Button Command="{Binding Navigation.ReloadCommand}">
                    <Svg Path="/Assets/Icons/Reload.svg"
                         Width="15"
                         Height="15"
                         Css="path { stroke: white }" />
                </Button>
            </StackPanel>

            <Grid Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <Border Grid.Column="0"
                        Background="#1C1C1C"
                        CornerRadius="2"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Navigation.CurrentPath}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Border Grid.Column="1"
                        Background="#1C1C1C"
                        CornerRadius="2"
                        Padding="10,6"
                        Width="210"
                        VerticalAlignment="Center">
                    <TextBlock Text="Rechercher..."
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
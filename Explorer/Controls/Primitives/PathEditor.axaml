<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="PathEditorControl"
             x:Class="Explorer.Controls.Primitives.PathEditor">

    <Grid>
        <TextBox Name="InputBox"
                 Text="{Binding Text, ElementName=PathEditorControl, Mode=TwoWay}"
                 FontSize="13"
                 TextWrapping="NoWrap"
                 Padding="10,6,30,6"
                 VerticalAlignment="Center">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand, ElementName=PathEditorControl}" />
            </TextBox.KeyBindings>
        </TextBox>

        <Button Name="ClearButton"
                Classes="ghost"
                Click="OnClearClick"
                Focusable="False"
                Padding="4"
                Margin="0,0,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsVisible="{Binding #InputBox.IsFocused}">
            <Svg Path="/Assets/Icons/Close.svg"
                 Width="13" Height="13"
                 Css="path { fill: white }"
                 IsHitTestVisible="False" />
        </Button>
    </Grid>
</UserControl>
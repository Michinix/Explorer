<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="PathEditorControl"
             x:Class="Explorer.Controls.Primitives.PathEditor">

    <Border Background="{StaticResource TextBoxBackground}" CornerRadius="3" Padding="10,6" VerticalAlignment="Center">
        <TextBox Text="{Binding Text, ElementName=PathEditorControl, Mode=TwoWay}"
                 FontSize="13"
                 TextWrapping="NoWrap">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand, ElementName=PathEditorControl}" />
            </TextBox.KeyBindings>
        </TextBox>
    </Border>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="IconButtonControl"
             x:Class="Explorer.Controls.Primitives.IconButton">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Svg">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Css" Value="path { fill: white }" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Button:disabled Svg">
            <Setter Property="Css" Value="path { opacity: 0.35 }" />
        </Style>
    </UserControl.Styles>

    <Button Command="{Binding Command, ElementName=IconButtonControl}">
        <Svg Path="{Binding IconPath, ElementName=IconButtonControl}" />
    </Button>
</UserControl>
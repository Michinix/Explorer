<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="IconButtonControl"
             x:Class="Explorer.Controls.Primitives.IconButton">

	<UserControl.Styles>
		<Style Selector="Svg">
			<Setter Property="Width" Value="15" />
			<Setter Property="Height" Value="15" />
			<Setter Property="IsHitTestVisible" Value="False" />
		</Style>

		<Style Selector="Button:disabled">
			<Setter Property="Opacity" Value="0.35" />
		</Style>
	</UserControl.Styles>

	<Button Classes="ghost"
	        IsEnabled="{Binding IsEnabled, ElementName=IconButtonControl}"
	        Command="{Binding Command, ElementName=IconButtonControl}">
		<Svg Path="{Binding IconPath, ElementName=IconButtonControl}"
		     Css="{Binding IconCss, ElementName=IconButtonControl}" />
	</Button>
</UserControl>
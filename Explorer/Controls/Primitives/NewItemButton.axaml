<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="NewItemButtonControl"
             x:Class="Explorer.Controls.Primitives.NewItemButton">

    <UserControl.Styles>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="Foreground" Value="{StaticResource ColorWhiteBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource BorderDefault}" />
        </Style>

        <Style Selector="MenuFlyoutPresenter MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource BorderDefault}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Button>
        <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" HorizontalOffset="-5" VerticalOffset="5">
                <MenuItem Header="Dossier" Command="{Binding CreateFolderCommand, ElementName=NewItemButtonControl}">
                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/Directory.svg" Width="14" Height="14"
                             Css="path { fill: #00AAFF; stroke: #00AAFF } " />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fichier" Command="{Binding CreateFileCommand, ElementName=NewItemButtonControl}">
                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/Document.svg" Width="14" Height="14" Css="path { fill: transparent; }" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuFlyout>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Svg Path="/Assets/Icons/New.svg" Width="15" Height="15"
                 Css="path { fill: white }" IsHitTestVisible="False" />
            <TextBlock Text="Nouveau" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
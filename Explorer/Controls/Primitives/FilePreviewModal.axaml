<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Explorer.Controls.Primitives"
             mc:Ignorable="d"
             x:Name="FilePreviewModalControl"
             x:Class="Explorer.Controls.Primitives.FilePreviewModal"
             Focusable="True"
             IsVisible="{Binding IsOpen, ElementName=FilePreviewModalControl}"
             KeyDown="OnKeyDown">

    <Grid Background="{StaticResource OverlayDim}"
          PointerPressed="OnOverlayPointerPressed">

        <Border Background="{StaticResource SurfaceOverlay}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="25,20"
                MinWidth="320"
                MaxWidth="480"
                MaxHeight="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PointerPressed="OnCardPointerPressed">

            <Grid RowDefinitions="Auto, *, Auto">
                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        Click="OnCloseClicked"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        MinWidth="0"
                        MinHeight="0"
                        Cursor="Hand">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{StaticResource ForegroundMuted}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round" />
                </Button>

                <StackPanel Grid.Row="1" Spacing="15" Margin="0,10" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Name="PreviewImage"
                           MaxWidth="360"
                           MaxHeight="280"
                           Stretch="Uniform"
                           IsVisible="False" />

                    <local:FileIcon Name="FallbackIcon"
                                    Width="70" Height="76"
                                    HorizontalAlignment="Center"
                                    IconBrush="{Binding Entry?.IconBrush, ElementName=FilePreviewModalControl}"
                                    IconLabel="{Binding Entry?.IconLabel, ElementName=FilePreviewModalControl}"
                                    IsDirectory="{Binding Entry?.IsDirectory, ElementName=FilePreviewModalControl}" />

                    <TextBlock Text="{Binding Entry?.Name, ElementName=FilePreviewModalControl}"
                               Foreground="{StaticResource ColorWhiteBrush}"
                               FontSize="15"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Entry?.TypeLabel, ElementName=FilePreviewModalControl}"
                               Foreground="{StaticResource ForegroundMuted}"
                               FontSize="12" />
                    <TextBlock Text="{Binding Entry?.DisplaySize, ElementName=FilePreviewModalControl}"
                               Foreground="{StaticResource ForegroundMuted}"
                               FontSize="12" />
                    <TextBlock Text="{Binding Entry?.LastModified, ElementName=FilePreviewModalControl}"
                               Foreground="{StaticResource ForegroundMuted}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
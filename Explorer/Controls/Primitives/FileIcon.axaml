<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Explorer.Controls.Primitives"
             x:Name="FileIconControl"
             x:Class="Explorer.Controls.Primitives.FileIcon">

    <Viewbox Stretch="Uniform">
        <Grid Width="16" Height="18">

            <Svg Path="/Assets/Icons/Directory.svg"
                 Width="16"
                 Stretch="Uniform"
                 Css="path { fill: #00AAFF}"
                 IsVisible="{Binding IsDirectory, RelativeSource={RelativeSource AncestorType={x:Type local:FileIcon}}}" />

            <Svg Path="/Assets/Icons/File.svg"
                 Width="14"
                 Stretch="Uniform"
                 Css="path { stroke: white }"
                 IsVisible="{Binding !IsDirectory, RelativeSource={RelativeSource AncestorType={x:Type local:FileIcon}}}" />
        </Grid>
    </Viewbox>
</UserControl>
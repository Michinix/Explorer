<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:controls="using:Explorer.Controls"
             mc:Ignorable="d"
             x:Name="AsideRightControl"
             x:Class="Explorer.Controls.AsideRight"
             x:DataType="vm:DataGridViewModel">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{StaticResource ColorWhiteBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}" />
            <Setter Property="Opacity" Value="0.90" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="1,0,0,0"
            BorderBrush="{StaticResource BorderDefault}">

        <Grid RowDefinitions="45,*">
            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BorderDefault}">

                <Grid VerticalAlignment="Center" Margin="13,0">
                    <TextBlock Text="APERÇU"
                               FontWeight="Medium"
                               FontSize="14"
                               Foreground="{StaticResource ColorWhite}" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <StackPanel IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}"
                            Orientation="Vertical"
                            Spacing="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Svg Path="/Assets/Icons/Element.svg"
                         Width="19"
                         Height="19"
                         HorizontalAlignment="Center"
                         Css="path { stroke: #848484 }" />

                    <TextBlock Text="Sélectionner un élément"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource ForegroundMuted}" />

                </StackPanel>

                <StackPanel IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Orientation="Vertical"
                            Spacing="15"
                            Margin="10,10,10,0"
                            HorizontalAlignment="Stretch">

                    <StackPanel Spacing="15">
                        <controls:FileIcon Width="58" Height="60"
                                           HorizontalAlignment="Center"
                                           IconBrush="{Binding SelectedEntry?.IconBrush}"
                                           IconLabel="{Binding SelectedEntry?.IconLabel}"
                                           IsDirectory="{Binding SelectedEntry?.IsDirectory}" />

                        <TextBlock Text="{Binding SelectedEntry?.Name}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Foreground="{StaticResource ColorWhiteBrush}"
                                   FontWeight="Regular" FontSize="14" />

                        <Border BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="0,1,0,0"
                                HorizontalAlignment="Stretch"
                                Margin="10,0" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="TYPE"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorWhiteBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding SelectedEntry?.TypeLabel}"
                                   Foreground="{StaticResource ForegroundMuted}"
                                   FontWeight="Regular" FontSize="12" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="TAILLE"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorWhiteBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding SelectedEntry?.DisplaySize}"
                                   Foreground="{StaticResource ForegroundMuted}"
                                   FontWeight="Regular" FontSize="12" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="MODIFIÉ LE"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorWhiteBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding SelectedEntry?.LastModified}"
                                   Foreground="{StaticResource ForegroundMuted}"
                                   FontWeight="Regular" FontSize="12" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding !SelectedEntry?.IsDirectory}"
                                Spacing="15">
                        <Border BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="0,1,0,0"
                                HorizontalAlignment="Stretch"
                                Margin="10,0" />

                        <Button Command="{Binding OpenSelectedFileCommand}"
                                HorizontalAlignment="Stretch"
                                FontSize="12" Padding="8,5"
                                FontWeight="Medium">
                            Ouvrir
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
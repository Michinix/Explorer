<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:models="using:Explorer.Models"
             mc:Ignorable="d"
             x:Class="Explorer.Controls.DataGrid"
             x:Name="DataGridControl"
             x:DataType="vm:DataGridViewModel">

    <DataGrid SelectedItem="{Binding SelectedEntry}"
              DoubleTapped="OnRowDoubleTapped"
              ItemsSource="{Binding Entries}"
              SelectionMode="Extended"
              AutoGenerateColumns="False"
              Foreground="{StaticResource ColorWhite}"
              GridLinesVisibility="All"
              HorizontalGridLinesBrush="{StaticResource BorderDefault}"
              VerticalGridLinesBrush="{StaticResource BorderDefault}"
              CanUserReorderColumns="False"
              VerticalAlignment="Top"
              IsReadOnly="True">

        <DataGrid.Styles>
            <Style Selector="DataGridColumnHeader:nth-child(1)">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style Selector="DataGridColumnHeader:nth-child(-n+4)">
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>

            <Style Selector="DataGridCell.colName TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ColorWhite}" />
            </Style>

            <Style Selector="DataGridCell.colMeta TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ForegroundMuted}" />
            </Style>

            <Style Selector="DataGridCell:nth-child(1)">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </DataGrid.Styles>

        <DataGrid.Columns>
            <DataGridTemplateColumn Width="45" CanUserResize="False" CanUserSort="False">
                <DataGridTemplateColumn.Header>
                    <CheckBox IsChecked="{Binding #DataGridControl.((vm:DataGridViewModel)DataContext)?.AllSelected, Mode=TwoWay}"
                              HorizontalAlignment="Center" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:FileSystemEntry">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="NOM"
                                Binding="{Binding Name, Mode=OneWay}"
                                Width="2*"
                                CellStyleClasses="colName" />

            <DataGridTextColumn Header="TAILLE"
                                Binding="{Binding DisplaySize, Mode=OneWay}"
                                Width="100"
                                CellStyleClasses="colMeta" />

            <DataGridTextColumn Header="TYPE"
                                Binding="{Binding DisplayType, Mode=OneWay}"
                                Width="100"
                                CellStyleClasses="colMeta" />

            <DataGridTextColumn Header="MODIFIÉ LE"
                                Binding="{Binding LastModified, Mode=OneWay}"
                                Width="150"
                                CellStyleClasses="colMeta" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
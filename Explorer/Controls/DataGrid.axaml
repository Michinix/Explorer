<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:models="using:Explorer.Models"
             xmlns:primitives="using:Explorer.Controls.Primitives"
             mc:Ignorable="d"
             x:Name="DataGridControl"
             x:Class="Explorer.Controls.DataGrid"
             x:DataType="vm:DataGridViewModel">

    <UserControl.Styles>
        <Style Selector="DataGridColumnHeader:nth-child(1)">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="DataGridCell.colName TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorWhite}" />
        </Style>

        <Style Selector="DataGridCell.colMeta TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundMuted}" />
        </Style>

        <Style Selector="DataGridCell:nth-child(1)">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.RenameInput">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style Selector="StackPanel.EmptyState">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Spacing" Value="12" />
        </Style>

        <Style Selector="StackPanel.EmptyState > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorWhiteBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.LoadingOverlay">
            <Setter Property="Background" Value="#80000000" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <DataGrid SelectedItem="{Binding SelectedEntry}"
                  DoubleTapped="OnRowDoubleTapped"
                  KeyDown="OnDataGridKeyDown"
                  ItemsSource="{Binding Entries}"
                  SelectionMode="Extended"
                  AutoGenerateColumns="False"
                  Foreground="{StaticResource ColorWhite}"
                  GridLinesVisibility="None"
                  CanUserReorderColumns="False"
                  VerticalAlignment="Top"
                  BorderThickness="0"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="45" CanUserResize="False" CanUserSort="False"
                                        CellStyleClasses="has-border">
                    <DataGridTemplateColumn.Header>
                        <CheckBox IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding !!Entries.Count}"
                                  HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:FileSystemEntry">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="NOM" Width="2*" CellStyleClasses="colName has-border"
                                        CanUserSort="True" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:FileSystemEntry">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <primitives:FileIcon Width="18" Height="20"
                                                     IsDirectory="{Binding IsDirectory}" />

                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding !IsEditing}" />

                                <TextBox Classes="RenameInput"
                                         Text="{Binding EditableName}"
                                         IsVisible="{Binding IsEditing}"
                                         Loaded="OnRenameTextBoxLoaded"
                                         LostFocus="OnRenameTextBoxLostFocus">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding ((vm:DataGridViewModel)DataContext)?.FileOps.CommitRenameCommand, ElementName=DataGridControl}"
                                                    CommandParameter="{Binding}" />
                                        <KeyBinding Gesture="Escape"
                                                    Command="{Binding ((vm:DataGridViewModel)DataContext)?.FileOps.CancelRenameCommand, ElementName=DataGridControl}"
                                                    CommandParameter="{Binding}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="TAILLE"
                                    Binding="{Binding DisplaySize, Mode=OneWay}"
                                    SortMemberPath="Size"
                                    Width="100"
                                    CellStyleClasses="colMeta has-border" />

                <DataGridTextColumn Header="TYPE"
                                    Binding="{Binding DisplayType, Mode=OneWay}"
                                    Width="100"
                                    CellStyleClasses="colMeta has-border" />

                <DataGridTextColumn Header="MODIFIÉ LE"
                                    Binding="{Binding LastModified, Mode=OneWay}"
                                    Width="150"
                                    CellStyleClasses="colMeta" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Classes="EmptyState" IsVisible="{Binding NoResultsFound}">
            <Svg Path="/Assets/Icons/Search.svg" Width="20" Height="20" Css="path { stroke: white }, circle { stroke: white }" HorizontalAlignment="Center" />
            <TextBlock Text="Aucune correspondance trouvée" />
        </StackPanel>

        <Border Classes="LoadingOverlay" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="120" />
                <TextBlock Text="Chargement..." Foreground="{StaticResource ColorWhite}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
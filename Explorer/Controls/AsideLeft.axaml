<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d"
             x:Name="AsideLeftControl"
             x:Class="Explorer.Controls.AsideLeft"
             x:DataType="vm:AsideLeftViewModel">

    <UserControl.Styles>
        <Style Selector="Button.MenuLink">
            <Setter Property="Foreground" Value="{StaticResource ColorWhiteBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0, 5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.MenuLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundMuted}" />
            <Setter Property="Margin" Value="13, 15, 13, 12" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource BorderDefault}">

        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical">
                <TextBlock Classes="SectionTitle" Text="ACCÈS RAPIDE" />

                <StackPanel Orientation="Vertical" Spacing="10" Margin="13,0">
                    <Button Classes="MenuLink" Command="{Binding NavigateToDesktopCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Svg Path="/Assets/Icons/Home.svg" Width="15" Height="15" VerticalAlignment="Center"
                                 Css="path { stroke: white }" />
                            <TextBlock Text="Bureau" FontSize="13" FontWeight="Normal" />
                        </StackPanel>
                    </Button>

                    <Button Classes="MenuLink" Command="{Binding NavigateToDownloadsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Svg Path="/Assets/Icons/Download.svg" Width="15" Height="15" VerticalAlignment="Center"
                                 Css="path { stroke: white }" />
                            <TextBlock Text="Téléchargements" FontSize="13" FontWeight="Normal" />
                        </StackPanel>
                    </Button>

                    <Button Classes="MenuLink" Command="{Binding NavigateToDocumentsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Svg Path="/Assets/Icons/Document.svg" Width="15" Height="15" VerticalAlignment="Center"
                                 Css="path { stroke: white }" />
                            <TextBlock Text="Documents" FontSize="13" FontWeight="Normal" />
                        </StackPanel>
                    </Button>

                    <Button Classes="MenuLink" Command="{Binding NavigateToPicturesCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Svg Path="/Assets/Icons/Picture.svg" Width="15" Height="15" VerticalAlignment="Center"
                                 Css="path { stroke: white }" />
                            <TextBlock Text="Images" FontSize="13" FontWeight="Normal" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Border BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="0,1,0,0"
                    HorizontalAlignment="Stretch"
                    Margin="13,20,13,0" />

            <StackPanel Orientation="Vertical">
                <TextBlock Classes="SectionTitle" Text="EMPLACEMENTS" />
            </StackPanel>

        </StackPanel>

    </Border>
</UserControl>
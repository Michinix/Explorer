<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:models="using:Explorer.Models"
             mc:Ignorable="d"
             x:Name="AsideLeftControl"
             x:Class="Explorer.Controls.AsideLeft"
             x:DataType="vm:AsideLeftViewModel">

    <Border BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource BorderDefault}">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="True">

            <StackPanel Orientation="Vertical" Spacing="15" Margin="0,15,0,10">

                <Border Margin="13,0,13,0">
                    <Button Theme="{StaticResource SidebarButtonTheme}"
                            Classes.active="{Binding IsHomeActive}"
                            Command="{Binding NavigateToHomeCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Svg Path="/Assets/Icons/Home.svg" Width="15" VerticalAlignment="Center"
                                 Css="path { stroke: white }" />
                            <TextBlock Text="Accueil" FontSize="13" FontWeight="Normal" />
                        </StackPanel>
                    </Button>
                </Border>

                <Expander x:Name="PinnedExpander" IsExpanded="True" Theme="{StaticResource AsideExpanderTheme}">
                    <Expander.Header>
                        <TextBlock Classes="SectionTitle" Text="Épinglé" />
                    </Expander.Header>

                    <StackPanel Orientation="Vertical"
                                Spacing="5"
                                Margin="13,4,13,10"
                                Tag="{Binding #PinnedExpander.IsExpanded}">

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsDesktopActive}"
                                Command="{Binding NavigateToDesktopCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Desktop.svg" Width="13" VerticalAlignment="Center"
                                     Css="path { stroke: white }" />
                                <TextBlock Text="Bureau" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsDownloadsActive}"
                                Command="{Binding NavigateToDownloadsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Download.svg" Width="15"
                                     VerticalAlignment="Center" Css="path { stroke: white }" />
                                <TextBlock Text="Téléchargements" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsDocumentsActive}"
                                Command="{Binding NavigateToDocumentsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Document.svg" Width="15"
                                     VerticalAlignment="Center" Css="path { stroke: white }" />
                                <TextBlock Text="Documents" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsPicturesActive}"
                                Command="{Binding NavigateToPicturesCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Picture.svg" Width="15" VerticalAlignment="Center"
                                     Css="path { stroke: white }" />
                                <TextBlock Text="Images" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>

                <Expander x:Name="DrivesExpander" IsExpanded="True" Theme="{StaticResource AsideExpanderTheme}">
                    <Expander.Header>
                        <TextBlock Classes="SectionTitle" Text="Lecteurs" />
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding Drives}"
                                  Margin="13,4,13,10"
                                  Tag="{Binding #DrivesExpander.IsExpanded}"
                                  ItemContainerTheme="{StaticResource DriveItemContainerTheme}">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="models:DriveItem">
                                <Setter Property="Classes.active" Value="{Binding IsActive}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveItem">
                                <Button Theme="{StaticResource SidebarButtonTheme}"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding #AsideLeftControl.DataContext?.NavigateToDriveCommand}"
                                        CommandParameter="{Binding FullPath}"
                                        x:CompileBindings="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                        <Svg Path="/Assets/Icons/Drive.svg" Width="15" Height="15"
                                             VerticalAlignment="Center" Css="path { stroke: white }" />

                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   FontWeight="Normal"
                                                   Foreground="{StaticResource ColorWhiteBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:models="using:Explorer.Models"
             mc:Ignorable="d"
             x:Name="AsideLeftControl"
             x:Class="Explorer.Controls.AsideLeft"
             x:DataType="vm:AsideLeftViewModel">

    <UserControl.Styles>
        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10, 8, 10, 8" />
        </Style>

        <Style Selector="Button.ghost.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
        </Style>

        <Style Selector="Button.ghost.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHighlight}" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource BorderDefault}">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="True">

            <StackPanel Orientation="Vertical" Spacing="15" Margin="0,15,0,10">

                <Border Margin="13,0,13,0">

                    <Button Classes="ghost"
                            Classes.active="{Binding IsHomeActive}"
                            Command="{Binding NavigateToHomeCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Svg Path="/Assets/Icons/Home.svg" Width="15" VerticalAlignment="Center"
                                 Css="path { stroke: white }" />
                            <TextBlock Text="Accueil" FontSize="13" FontWeight="Normal" />
                        </StackPanel>
                    </Button>
                </Border>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Classes="SectionTitle" Text="Épinglé" />
                    </Expander.Header>

                    <StackPanel Orientation="Vertical" Spacing="5" Margin="13,4,13,10">
                        <Button Classes="ghost" Classes.active="{Binding IsDesktopActive}"
                                Command="{Binding NavigateToDesktopCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Desktop.svg" Width="13" VerticalAlignment="Center"
                                     Css="path { stroke: white }" />
                                <TextBlock Text="Bureau" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ghost" Classes.active="{Binding IsDownloadsActive}"
                                Command="{Binding NavigateToDownloadsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Download.svg" Width="15"
                                     VerticalAlignment="Center" Css="path { fill: white }" />
                                <TextBlock Text="Téléchargements" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ghost" Classes.active="{Binding IsDocumentsActive}"
                                Command="{Binding NavigateToDocumentsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Document.svg" Width="15"
                                     VerticalAlignment="Center" Css="path { stroke: white }" />
                                <TextBlock Text="Documents" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ghost" Classes.active="{Binding IsPicturesActive}"
                                Command="{Binding NavigateToPicturesCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Svg Path="/Assets/Icons/Picture.svg" Width="15" VerticalAlignment="Center"
                                     Css="path { stroke: white }" />
                                <TextBlock Text="Images" FontSize="13" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Classes="SectionTitle" Text="Lecteurs" />
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding Drives}" Margin="13,4,13,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveItem">
                                <Button Classes="ghost"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding #AsideLeftControl.DataContext?.NavigateToDriveCommand}"
                                        CommandParameter="{Binding FullPath}"
                                        x:CompileBindings="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                        <Svg Path="/Assets/Icons/Drive.svg" Width="15" Height="15"
                                             VerticalAlignment="Center" Css="path { fill: white }" />

                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   FontWeight="Normal"
                                                   Foreground="{StaticResource ColorWhiteBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
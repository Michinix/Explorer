<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:models="using:Explorer.Models"
             mc:Ignorable="d"
             x:Name="AsideLeftControl"
             x:Class="Explorer.Controls.AsideLeft"
             x:DataType="vm:AsideLeftViewModel">

    <UserControl.Styles>
        <Style Selector="Button > StackPanel > Svg">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Css" Value="path { stroke: white }" />
        </Style>

        <Style Selector="Button > StackPanel > TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button > StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Spacing" Value="10" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource BorderDefault}">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="True">

            <StackPanel Orientation="Vertical" Spacing="15" Margin="0,15,0,10">

                <Border Margin="13,0,13,0">
                    <Button Theme="{StaticResource SidebarButtonTheme}"
                            Classes.active="{Binding IsHomeActive}"
                            Command="{Binding NavigateToHomeCommand}">
                        <StackPanel>
                            <Svg Path="/Assets/Icons/Home.svg" />
                            <TextBlock Text="Accueil" />
                        </StackPanel>
                    </Button>
                </Border>

                <Expander x:Name="PinnedExpander" IsExpanded="True" Theme="{StaticResource AsideExpanderTheme}">
                    <Expander.Header>
                        <TextBlock Classes="SectionTitle" Text="Épinglé" />
                    </Expander.Header>

                    <StackPanel Orientation="Vertical"
                                Spacing="5"
                                Margin="13,4,13,10"
                                Tag="{Binding #PinnedExpander.IsExpanded}">

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsDesktopActive}"
                                Command="{Binding NavigateToDesktopCommand}">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/Desktop.svg" />
                                <TextBlock Text="Bureau" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsDownloadsActive}"
                                Command="{Binding NavigateToDownloadsCommand}">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/Download.svg" />
                                <TextBlock Text="Téléchargements" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsDocumentsActive}"
                                Command="{Binding NavigateToDocumentsCommand}">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/Document.svg" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </Button>

                        <Button Theme="{StaticResource SidebarButtonTheme}"
                                Classes.active="{Binding IsPicturesActive}"
                                Command="{Binding NavigateToPicturesCommand}">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/Picture.svg" />
                                <TextBlock Text="Images" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>

                <Expander x:Name="DrivesExpander" IsExpanded="True" Theme="{StaticResource AsideExpanderTheme}">
                    <Expander.Header>
                        <TextBlock Classes="SectionTitle" Text="Lecteurs" />
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding Drives}"
                                  Margin="13,4,13,10"
                                  Tag="{Binding #DrivesExpander.IsExpanded}"
                                  ItemContainerTheme="{StaticResource DriveItemContainerTheme}">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="models:DriveItem">
                                <Setter Property="Classes.active" Value="{Binding IsActive}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DriveItem">
                                <Button Theme="{StaticResource SidebarButtonTheme}"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding #AsideLeftControl.DataContext?.NavigateToDriveCommand}"
                                        CommandParameter="{Binding FullPath}"
                                        x:CompileBindings="False">
                                    <StackPanel>
                                        <Svg Path="/Assets/Icons/Drive.svg" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource ColorWhiteBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
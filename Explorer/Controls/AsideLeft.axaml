<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="AsideLeftControl"
             x:Class="Explorer.Controls.AsideLeft"
             x:DataType="vm:AsideLeftViewModel">

    <Border BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource BorderDefault}">

        <Grid RowDefinitions="45,*">
            <Grid VerticalAlignment="Center" Margin="13,0">
                <TextBlock Text="ACCÈS RAPIDE"
                           FontWeight="Medium"
                           FontSize="14"
                           Foreground="{StaticResource ForegroundMuted}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
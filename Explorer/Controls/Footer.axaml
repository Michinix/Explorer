<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d"
             x:Name="FooterControl"
             x:Class="Explorer.Controls.Footer"
             x:DataType="vm:FileBrowserViewModel">

	<UserControl.Styles>
		<Style Selector="ProgressBar.ocr">
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="MinHeight" Value="0" />
		</Style>

		<Style Selector="Button.ghost">
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
	</UserControl.Styles>

	<Border Background="Transparent"
	        BorderThickness="0,1,0,0"
	        BorderBrush="{StaticResource BorderDefault}">

		<Grid ColumnDefinitions="*, Auto" Margin="15, 10" Height="16">
			<StackPanel Grid.Column="0"
			            Orientation="Horizontal"
			            VerticalAlignment="Center"
			            Spacing="6">

				<TextBlock FontSize="11"
				           VerticalAlignment="Center"
				           Text="{Binding ItemCountText}" />

				<TextBlock FontSize="11"
				           VerticalAlignment="Center"
				           Text="-" />

				<TextBlock FontSize="11"
				           VerticalAlignment="Center"
				           Text="{Binding SelectedItemCountText}" />

				<Border Classes="DividerVertical"
				        Height="12"
				        Margin="2,0"
				        IsVisible="{Binding IsOcrScanning}" />

				<TextBlock FontSize="11"
				           VerticalAlignment="Center"
				           IsVisible="{Binding IsOcrScanning}"
				           Text="{Binding OcrProgressText}" />

				<ProgressBar Classes="ocr"
				             Width="90"
				             Height="4"
				             Minimum="0"
				             VerticalAlignment="Center"
				             IsVisible="{Binding IsOcrScanning}"
				             Maximum="{Binding OcrTotal}"
				             Value="{Binding OcrDone}" />

				<Button Classes="ghost"
				        Padding="4,0"
				        VerticalAlignment="Center"
				        IsVisible="{Binding IsOcrScanning}"
				        Command="{Binding CancelOcrCommand}">
					<TextBlock FontSize="11"
					           VerticalAlignment="Center"
					           Foreground="{StaticResource AccentPrimary}"
					           Text="Annuler" />
				</Button>

			</StackPanel>

			<StackPanel Grid.Column="1"
			            Orientation="Horizontal"
			            VerticalAlignment="Center">

				<TextBlock FontSize="11"
				           VerticalAlignment="Center"
				           Text="{Binding AppVersion}" />
			</StackPanel>
		</Grid>
	</Border>
</UserControl>

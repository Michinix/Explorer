<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d"
             x:Name="FooterControl"
             x:Class="Explorer.Controls.Footer"
             x:DataType="vm:FileBrowserViewModel">

	<Border Background="Transparent"
	        BorderThickness="0,1,0,0"
	        BorderBrush="{StaticResource BorderDefault}">

		<Grid ColumnDefinitions="*, Auto" Margin="15, 10">
			<StackPanel Grid.Column="0"
			            Orientation="Horizontal"
			            VerticalAlignment="Center"
			            Spacing="6">

				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock FontSize="11"
					           Text="{Binding ItemCountText}" />

					<TextBlock FontSize="11" Text="-" VerticalAlignment="Center" />

					<TextBlock FontSize="11"
					           Text="{Binding SelectedItemCountText}" />
				</StackPanel>

				<StackPanel Orientation="Horizontal"
				            Spacing="8"
				            VerticalAlignment="Center"
				            IsVisible="{Binding IsOcrScanning}">

					<Border Width="1" Height="12" Background="{StaticResource BorderDefault}" />

					<TextBlock FontSize="11"
					           VerticalAlignment="Center"
					           Text="{Binding OcrProgressText}" />

					<ProgressBar Width="90"
					             Height="4"
					             Minimum="0"
					             VerticalAlignment="Center"
					             Maximum="{Binding OcrTotal}"
					             Value="{Binding OcrDone}" />

					<Button Classes="ghost"
					        Padding="4,0"
					        Command="{Binding CancelOcrCommand}">
						<TextBlock FontSize="11" Foreground="{StaticResource AccentPrimary}" Text="Annuler" />
					</Button>
				</StackPanel>

			</StackPanel>

			<StackPanel Grid.Column="1"
			            Orientation="Horizontal"
			            VerticalAlignment="Center">

				<TextBlock FontSize="11">
					Explorer v1.0.0
				</TextBlock>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
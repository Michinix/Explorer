<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="ChromeControl"
             x:Class="Explorer.Controls.Chrome">

    <UserControl.Styles>
        <Style Selector="StackPanel#TrafficLights:pointerover Button /template/ Path.trafficIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource SurfaceElevated}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0"
            ClipToBounds="True">

        <Grid>
            <Border Background="Transparent"
                    PointerPressed="TitleBar_PointerPressed" />

            <StackPanel x:Name="TrafficLights"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="15,0"
                        Spacing="8"
                        IsHitTestVisible="True"
                        Cursor="Arrow">

                <Button Width="12" Height="12" MinWidth="12" MinHeight="12" Padding="0" Cursor="Arrow"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="#FF5F57" CornerRadius="7">
                                <Path Classes="trafficIcon"
                                      Data="M 0,0 L 4.6,4.6 M 4.6,0 L 0,4.6"
                                      Stroke="#4D0000"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      Opacity="0"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Width="12" Height="12" MinWidth="12" MinHeight="12" Padding="0" Cursor="Arrow"
                        Click="MinimizeButton_Click">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="#FFBD2E" CornerRadius="7">
                                <Path Classes="trafficIcon"
                                      Data="M 0,0 L 5,0"
                                      Stroke="#985700"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      Opacity="0"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Width="12" Height="12" MinWidth="12" MinHeight="12" Padding="0" Cursor="Arrow"
                        Click="MaximizeRestoreButton_Click">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="#28C840" CornerRadius="7">
                                <Path Classes="trafficIcon"
                                      Data="M 0,4.6 L 4.6,0 M 1.1,0 L 4.6,0 L 4.6,3.5 M 4.6,0 L 0,4.6 M 3.5,4.6 L 0,4.6 L 0,1.1"
                                      Stroke="#006500"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Opacity="0"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <TextBlock Text="Explorer"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="Regular"
                       Foreground="{StaticResource ColorWhiteBrush}" />
        </Grid>
    </Border>
</UserControl>
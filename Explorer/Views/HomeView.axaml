<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1024"
             x:Class="Explorer.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="4"
                    Background="{StaticResource DeepDark}"
                    Margin="8,6">
            <Button Content="←"
                    Command="{Binding GoBackCommand}"
                    FontSize="14"
                    Foreground="{StaticResource White}"
                    Padding="10,4"/>
            <Button Content="→"
                    Command="{Binding GoForwardCommand}"
                    FontSize="14"
                    Foreground="{StaticResource White}"
                    Padding="10,4"/>
            <Button Content="↑"
                    Command="{Binding GoUpCommand}"
                    FontSize="14"
                    Foreground="{StaticResource White}"
                    Padding="10,4"/>
            <TextBlock Text="{Binding CurrentPath}"
                       VerticalAlignment="Center"
                       Foreground="#888888"
                       FontSize="12"
                       Margin="8,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  SelectedItem="{Binding SelectedEntry}"
                  DoubleTapped="OnRowDoubleTapped"
                  ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False"
                  Foreground="{StaticResource Light}"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{StaticResource Dark}"
                  VerticalGridLinesBrush="{StaticResource Dark}"
                  CanUserReorderColumns="False"
                  IsReadOnly="True">

            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource DeepDark}"/>
                    <Setter Property="Foreground" Value="{StaticResource White}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Dark}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <Style Selector="DataGridRow:pointerover">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Style>
                <Style Selector="DataGridRow:selected">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="{StaticResource Light}"/>
                </Style>

                <!-- Colonne NOM -->
                <Style Selector="DataGridCell.colName TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource White}"/>
                </Style>

                <!-- Colonnes méta -->
                <Style Selector="DataGridCell.colMeta TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Medium}"/>
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn Header="NOM"        Binding="{Binding Name}"         Width="*"   CellStyleClasses="colName"/>
                <DataGridTextColumn Header="TAILLE"     Binding="{Binding DisplaySize}"  Width="90"  CellStyleClasses="colMeta"/>
                <DataGridTextColumn Header="TYPE"       Binding="{Binding Type}"         Width="100" CellStyleClasses="colMeta"/>
                <DataGridTextColumn Header="MODIFIE LE" Binding="{Binding LastModified}" Width="Auto" CellStyleClasses="colMeta"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:controls="using:Explorer.Controls"
             mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1024"
             x:Class="Explorer.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="{StaticResource BackgroundDefault}">
    <Panel>
        <controls:DataGrid DataContext="{Binding DataGrid}" />
    </Panel>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:controls="using:Explorer.Controls"
             xmlns:primitives="using:Explorer.Controls.Primitives"
             mc:Ignorable="d"
             x:Class="Explorer.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <StackPanel Grid.Row="0">
            <primitives:Chrome Height="40" />
            <controls:NavBar DataContext="{Binding NavBar}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto">

            <controls:AsideLeft Grid.Column="0"
                                MinWidth="220"
                                MaxWidth="250"
                                DataContext="{Binding AsideLeft}" />

            <controls:DataGrid Grid.Column="1"
                               MinWidth="400"
                               MinHeight="300"
                               DataContext="{Binding DataGrid}" />

            <controls:AsideRight Grid.Column="2"
                                 MinWidth="220"
                                 MaxWidth="250"
                                 DataContext="{Binding DataGrid}" />

        </Grid>

        <controls:Footer Grid.Row="3" DataContext="{Binding DataGrid}" />
    </Grid>
</UserControl>
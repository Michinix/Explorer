<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:controls="using:Explorer.Controls"
             mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1024"
             x:Class="Explorer.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <StackPanel Grid.Row="0">
            <controls:Chrome Height="40" />
            <controls:NavBar Height="40"
                             DataContext="{Binding NavBar}" />
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="0.225*,*,0.225*">

            <controls:AsideLeft Grid.Column="0" />

            <controls:DataGrid Grid.Column="1"
                               DataContext="{Binding DataGrid}" />

            <controls:AsideRight Grid.Column="2" DataContext="{Binding DataGrid}" />

        </Grid>

        <controls:Footer Grid.Row="3"
                         DataContext="{Binding DataGrid}" />

    </Grid>
</UserControl>
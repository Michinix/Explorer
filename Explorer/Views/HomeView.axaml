<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Explorer.ViewModels"
             xmlns:controls="using:Explorer.Controls"
             mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1024"
             x:Class="Explorer.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    
    <Grid RowDefinitions="Auto, Auto, *, Auto">
        
        <controls:Chrome Grid.Row="0" 
                         Height="40"
                         Margin="0"/>
        
        <controls:NavBar Grid.Row="1" 
                         Height="40"
                         Margin="0"
                         DataContext="{Binding NavBar}"
                         />
        
        <controls:DataGrid Grid.Row="2" 
                           Margin="0"
                           DataContext="{Binding DataGrid}" />
        
        <controls:Footer Grid.Row="3"
                         Margin="0"
                         DataContext="{Binding DataGrid}" />
    </Grid>
</UserControl>
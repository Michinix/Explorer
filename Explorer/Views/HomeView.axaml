<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="using:System.IO"
             xmlns:vm="using:Explorer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1024"
             x:Class="Explorer.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <DockPanel>
        <!-- User Info -->
        <TextBlock DockPanel.Dock="Top" 
                   Text="{Binding User, StringFormat='Utilisateur: {0}'}"
                   Margin="10" FontSize="14"/>

        <!-- Navigation Bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="5" Margin="10">
            <!-- Back Button -->
            <Button Command="{Binding GoBackCommand}" 
                    IsEnabled="{Binding CanGoBack}"
                    Padding="10,5" Content="← Retour"/>

            <!-- Forward Button -->
            <Button Command="{Binding GoForwardCommand}" 
                    IsEnabled="{Binding CanGoForward}"
                    Padding="10,5" Content="Avant →"/>

            <!-- Home Button -->
            <Button Command="{Binding GoHomeCommand}"
                    Padding="10,5" Content="🏠 Accueil"/>
        </StackPanel>

        <!-- Path Display and Navigation -->
        <StackPanel DockPanel.Dock="Top" Margin="10" Spacing="5">
            <TextBlock Text="Chemin actuel:" FontWeight="Bold"/>
            
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <!-- Path TextBox -->
                <TextBox Grid.Column="0" 
                         Text="{Binding CurrentPath}"
                         PlaceholderText="Entrez un chemin..."
                         Padding="10"/>
                
                <!-- Navigate Button -->
                <Button Grid.Column="1" 
                        Command="{Binding NavigateToPathCommand}"
                        CommandParameter="{Binding CurrentPath}"
                        Content="Aller"
                        Margin="5,0,0,0"
                        Padding="15,5"/>
            </Grid>

            <!-- Display Current Path -->
            <TextBlock Text="{Binding CurrentPath}" 
                       Foreground="Gray" 
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content Area -->
        <Grid ColumnDefinitions="*,*">
            <!-- Directories -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Dossiers" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding Directories}"
                         BorderThickness="1" 
                         BorderBrush="LightGray"
                         x:Name="DirectoriesListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="system:DirectoryInfo">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="📁" FontSize="16"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FullName}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>

            <!-- Files -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Fichiers" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding Files}"
                         BorderThickness="1" 
                         BorderBrush="LightGray">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="system:FileInfo">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="📄" FontSize="16"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Length, StringFormat='N0'}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Extension}" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

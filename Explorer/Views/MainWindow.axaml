<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Explorer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Explorer.Views"
        mc:Ignorable="d"
        x:Class="Explorer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Explorer"
        Icon="/Assets/Logo.ico"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="Transparent"
        CanResize="True"
        Width="1300"
        Height="750"
        UseLayoutRounding="True"
        TransparencyLevelHint="Transparent">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:SplashViewModel">
            <views:SplashView />
        </DataTemplate>

        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
    </Window.DataTemplates>

    <Border Margin="1"
            Background="{StaticResource BackgroundDefault}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">

        <TransitioningContentControl Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
                <CompositePageTransition>
                    <CrossFade Duration="0:0:0.30" />
                    <PageSlide Duration="0:0:0.38"
                               Orientation="Horizontal" />
                </CompositePageTransition>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

    </Border>

</Window>
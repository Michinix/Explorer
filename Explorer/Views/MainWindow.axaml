<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Explorer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Explorer.Views"
        mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1024"
        x:Class="Explorer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{StaticResource Darkest}"
        WindowStartupLocation="CenterScreen" CanResize="False"
        MinWidth="200" MinHeight="200"
        MaxWidth="1900" MaxHeight="1024"
        Icon="/Assets/Icons/Logo.ico" 
        Title="Explorer">
    
    <Window.DataTemplates>
        <DataTemplate DataType="vm:SplashViewModel">
            <views:SplashView />
        </DataTemplate>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
    </Window.DataTemplates>

    <TransitioningContentControl Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
            <CompositePageTransition>
                <CrossFade Duration="0:0:0.30" />
                <PageSlide Duration="0:0:0.38"
                           Orientation="Horizontal" />
            </CompositePageTransition>
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
</Window>
